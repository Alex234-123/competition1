{
  "name": "multi-platform-publisher",
  "version": "0.1.0",
  "private": true,
  "description": "多平台内容发布工具 — 一份内容自动适配公众号/知乎/B站/小红书并一键发布(默认模拟)",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/app",
    "packages/server"
  ],
  "scripts": {
    "build:core": "npm run build -w @mpp/core",
    "dev": "npm run dev -w @mpp/app",
    "build:ext": "npm run build:ext -w @mpp/app",
    "server": "npm run build:core && npm run dev -w @mpp/server",
    "demo": "node scripts/demo.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.14.0",
    "lint-staged": "^15.3.0",
    "simple-git-hooks": "^2.11.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix"
  },
  "engines": {
    "node": ">=20"
  }
}
