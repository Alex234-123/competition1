{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["chrome", "vite/client"],
    "moduleResolution": "Bundler",
    "noEmit": false,
    "outDir": "./dist-types",
    "rootDir": "./src"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "references": [{ "path": "../core" }],
  "exclude": ["dist", "dist-ext", "node_modules"]
}
